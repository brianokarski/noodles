{
  "$meta": {
    "name": "Moth Component Patterns",
    "description": "Reusable component patterns with auto-layout specifications",
    "version": "1.0.0"
  },

  "autoLayoutRules": {
    "$description": "Standard auto-layout configurations",
    
    "stack": {
      "vertical": {
        "direction": "vertical",
        "alignment": "start",
        "distribution": "packed"
      },
      "horizontal": {
        "direction": "horizontal",
        "alignment": "center",
        "distribution": "packed"
      },
      "center": {
        "direction": "vertical",
        "alignment": "center",
        "distribution": "packed"
      }
    },

    "spacing": {
      "tight":   { "gap": "{space.1}" },
      "compact": { "gap": "{space.2}" },
      "normal":  { "gap": "{space.4}" },
      "relaxed": { "gap": "{space.6}" },
      "loose":   { "gap": "{space.8}" }
    },

    "padding": {
      "none":    { "padding": "{space.0}" },
      "tight":   { "padding": "{space.2}" },
      "compact": { "padding": "{space.3}" },
      "normal":  { "padding": "{space.4}" },
      "relaxed": { "padding": "{space.6}" },
      "loose":   { "padding": "{space.8}" }
    }
  },

  "atoms": {
    "$description": "Smallest building blocks",

    "icon": {
      "sizes": {
        "xs": { "size": 12 },
        "sm": { "size": 16 },
        "md": { "size": 20 },
        "lg": { "size": 24 },
        "xl": { "size": 32 }
      },
      "autoLayout": null
    },

    "text": {
      "variants": ["display", "heading", "body", "label", "code"],
      "autoLayout": null
    },

    "divider": {
      "horizontal": {
        "height": 1,
        "width": "fill",
        "color": "{color.border.primary}"
      },
      "vertical": {
        "width": 1,
        "height": "fill",
        "color": "{color.border.primary}"
      }
    },

    "spacer": {
      "sizes": {
        "xs":  { "size": "{space.2}" },
        "sm":  { "size": "{space.4}" },
        "md":  { "size": "{space.6}" },
        "lg":  { "size": "{space.8}" },
        "xl":  { "size": "{space.12}" },
        "2xl": { "size": "{space.16}" }
      }
    }
  },

  "molecules": {
    "$description": "Compositions of atoms",

    "buttonGroup": {
      "autoLayout": {
        "direction": "horizontal",
        "alignment": "center",
        "gap": "{space.2}"
      },
      "variants": {
        "attached": { "gap": 0, "childRadius": "none-between" },
        "separated": { "gap": "{space.2}" }
      }
    },

    "inputField": {
      "autoLayout": {
        "direction": "vertical",
        "alignment": "stretch",
        "gap": "{space.1.5}"
      },
      "children": [
        { "name": "label", "component": "text", "variant": "label.medium" },
        { "name": "input", "component": "input" },
        { "name": "helper", "component": "text", "variant": "body.small", "optional": true }
      ]
    },

    "mediaObject": {
      "autoLayout": {
        "direction": "horizontal",
        "alignment": "start",
        "gap": "{space.4}"
      },
      "children": [
        { "name": "media", "width": "hug", "component": "image|avatar|icon" },
        { "name": "content", "width": "fill", "autoLayout": { "direction": "vertical", "gap": "{space.1}" } }
      ]
    },

    "listItem": {
      "autoLayout": {
        "direction": "horizontal",
        "alignment": "center",
        "gap": "{space.3}",
        "padding": "{space.3}"
      },
      "children": [
        { "name": "leadingIcon", "optional": true },
        { "name": "content", "width": "fill" },
        { "name": "trailingElement", "optional": true }
      ]
    },

    "chip": {
      "autoLayout": {
        "direction": "horizontal",
        "alignment": "center",
        "gap": "{space.1.5}",
        "paddingX": "{space.3}",
        "paddingY": "{space.1.5}"
      },
      "children": [
        { "name": "icon", "optional": true },
        { "name": "label" },
        { "name": "removeButton", "optional": true }
      ]
    },

    "stat": {
      "autoLayout": {
        "direction": "vertical",
        "alignment": "start",
        "gap": "{space.1}"
      },
      "children": [
        { "name": "label", "component": "text", "variant": "label.medium" },
        { "name": "value", "component": "text", "variant": "display.small" },
        { "name": "trend", "optional": true }
      ]
    }
  },

  "organisms": {
    "$description": "Complex component compositions",

    "card": {
      "autoLayout": {
        "direction": "vertical",
        "alignment": "stretch",
        "gap": "{space.4}",
        "padding": "{card.padding.md}"
      },
      "structure": {
        "header": {
          "autoLayout": { "direction": "horizontal", "alignment": "center", "gap": "{space.3}" },
          "children": ["title", "subtitle?", "actions?"]
        },
        "media": {
          "aspectRatio": "16:9",
          "fit": "cover",
          "optional": true
        },
        "body": {
          "autoLayout": { "direction": "vertical", "gap": "{space.3}" }
        },
        "footer": {
          "autoLayout": { "direction": "horizontal", "alignment": "center", "gap": "{space.3}" },
          "optional": true
        }
      }
    },

    "header": {
      "autoLayout": {
        "direction": "horizontal",
        "alignment": "center",
        "distribution": "spaceBetween",
        "paddingX": "{spacing.page.gutter}",
        "height": "{navigation.height.header}"
      },
      "children": [
        { "name": "leading", "width": "hug", "autoLayout": { "direction": "horizontal", "gap": "{space.4}" } },
        { "name": "center", "width": "fill", "optional": true },
        { "name": "trailing", "width": "hug", "autoLayout": { "direction": "horizontal", "gap": "{space.2}" } }
      ]
    },

    "section": {
      "autoLayout": {
        "direction": "vertical",
        "alignment": "stretch",
        "gap": "{space.8}",
        "paddingY": "{spacing.section.md}"
      },
      "children": [
        { "name": "header", "autoLayout": { "direction": "vertical", "gap": "{space.2}" } },
        { "name": "content", "width": "fill" }
      ],
      "maxWidth": "{spacing.page.max}"
    },

    "hero": {
      "autoLayout": {
        "direction": "vertical",
        "alignment": "center",
        "gap": "{space.6}",
        "paddingY": "{spacing.section.lg}"
      },
      "children": [
        { "name": "eyebrow", "component": "text", "variant": "label.large" },
        { "name": "title", "component": "text", "variant": "display.large", "textAlign": "center" },
        { "name": "description", "component": "text", "variant": "body.large", "textAlign": "center", "maxWidth": "{size.3xl}" },
        { "name": "actions", "autoLayout": { "direction": "horizontal", "gap": "{space.4}" } }
      ]
    },

    "footer": {
      "autoLayout": {
        "direction": "vertical",
        "alignment": "stretch",
        "gap": "{space.12}",
        "paddingY": "{spacing.section.md}",
        "paddingX": "{spacing.page.gutter}"
      },
      "structure": {
        "main": {
          "autoLayout": { "direction": "horizontal", "distribution": "spaceBetween", "gap": "{space.8}" }
        },
        "bottom": {
          "autoLayout": { "direction": "horizontal", "alignment": "center", "distribution": "spaceBetween" }
        }
      }
    },

    "form": {
      "autoLayout": {
        "direction": "vertical",
        "alignment": "stretch",
        "gap": "{space.6}"
      },
      "children": [
        { "name": "fields", "autoLayout": { "direction": "vertical", "gap": "{space.4}" } },
        { "name": "actions", "autoLayout": { "direction": "horizontal", "gap": "{space.3}" } }
      ]
    },

    "modal": {
      "autoLayout": {
        "direction": "vertical",
        "alignment": "stretch",
        "gap": "{space.6}",
        "padding": "{modal.padding}"
      },
      "structure": {
        "header": {
          "autoLayout": { "direction": "horizontal", "alignment": "center", "distribution": "spaceBetween" }
        },
        "body": {
          "autoLayout": { "direction": "vertical", "gap": "{space.4}" }
        },
        "footer": {
          "autoLayout": { "direction": "horizontal", "alignment": "center", "distribution": "end", "gap": "{space.3}" }
        }
      }
    },

    "table": {
      "autoLayout": {
        "direction": "vertical",
        "alignment": "stretch"
      },
      "structure": {
        "header": {
          "autoLayout": { "direction": "horizontal", "alignment": "center" },
          "background": "{color.background.secondary}"
        },
        "row": {
          "autoLayout": { "direction": "horizontal", "alignment": "center" },
          "states": {
            "hover": { "background": "{color.background.secondary}" },
            "selected": { "background": "{color.brand.50}" }
          }
        },
        "cell": {
          "autoLayout": { "direction": "horizontal", "alignment": "center", "paddingX": "{space.4}", "paddingY": "{space.3}" }
        }
      }
    }
  },

  "templates": {
    "$description": "Full page layout templates",

    "dashboardPage": {
      "autoLayout": {
        "direction": "horizontal",
        "alignment": "stretch"
      },
      "structure": {
        "sidebar": { "width": 280, "autoLayout": { "direction": "vertical" } },
        "main": { 
          "width": "fill",
          "autoLayout": { "direction": "vertical" },
          "children": ["header", "content"]
        }
      }
    },

    "marketingPage": {
      "autoLayout": {
        "direction": "vertical",
        "alignment": "stretch"
      },
      "structure": {
        "header": { "sticky": true, "zIndex": "{zIndex.sticky}" },
        "hero": {},
        "sections": { "autoLayout": { "direction": "vertical", "gap": "{spacing.section.lg}" } },
        "footer": {}
      }
    },

    "authPage": {
      "autoLayout": {
        "direction": "horizontal",
        "alignment": "stretch"
      },
      "structure": {
        "visual": { "width": "50%", "display": { "mobile": "none" } },
        "form": { "width": "50%", "autoLayout": { "direction": "vertical", "alignment": "center", "distribution": "center" } }
      }
    }
  }
}

