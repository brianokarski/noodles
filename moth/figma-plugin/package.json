{
  "name": "moth-figma-plugin",
  "version": "1.0.0",
  "description": "Figma plugin for Moth design agent",
  "scripts": {
    "build": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es2020 && cp src/ui.html dist/ui.html",
    "watch": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es2020 --watch",
    "dev": "npm run build && echo 'Plugin built! Import manifest.json in Figma.'"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.89.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  }
}

